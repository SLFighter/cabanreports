# Конфиг сервера «Кабаньих сводок».
# Скопируй в .env и при желании поменяй значения.

# Порт HTTP-сервера
PORT=3000

# Режим верификации регистрации:
#   none     — учетка создается сразу (текущий режим)
#   telegram — создается заявка + код, подтверждается ботом (задел, нужен токен ниже)
#   email    — задел под подтверждение по почте (отправку писем еще нужно прикрутить)
REQUIRE_VERIFICATION=none

# Токен бота от @BotFather — нужен только для REQUIRE_VERIFICATION=telegram
TELEGRAM_BOT_TOKEN=

# Соль для хеширования IP в rate-limit-таблице (в проде задай свою случайную строку!)
IP_HASH_SECRET=change-me-to-random-string

# Сложность PoW: сколько ведущих нулевых бит должен найти браузер (19 ~ доля секунды)
POW_DIFFICULTY_BITS=19

# Максимум регистраций с одного IP за сутки
REGISTRATIONS_PER_IP_PER_DAY=3

# Сколько дней «живает» сессия после входа (галочка «Запомнить меня»)
SESSION_TTL_DAYS=30
